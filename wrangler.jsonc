{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mundo314",
  "main": "worker.ts",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mundo314-db"
    }
  ]
}
